# Create the bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=

# Durable state: subscriptions, admins, alerts, price history, and tracked wallets.
# Use a MongoDB Atlas connection string or Railway's MONGO_URL value.
MONGODB_URI=
MONGODB_DATABASE=onchain_trading_bot

# Comma-separated numeric Telegram user IDs allowed to run expensive admin commands.
# These are permanent owners and can create/revoke one-time invite-based admins.
TELEGRAM_ADMIN_USER_IDS=
# Captured Telegram messages are used by /export1d; default retention is seven days.
CHAT_HISTORY_RETENTION_SECONDS=604800
# Default lifetime for /admininvite links. Each link is single-use.
ADMIN_INVITE_TTL_SECONDS=3600

# OpenTwitter/6551 supplies X context only. Get a token at https://6551.io/mcp.
TWITTER_TOKEN=
TWITTER_ACCOUNTS=elonmusk,WhiteHouse,realDonaldTrump,cz_binance
TWITTER_SCAN_EVERY_MS=120000

# Signal discovery and deduplication. Five minutes is friendly to GMGN rate limits.
SCANNER_ENABLED=true
SCAN_INTERVAL_MS=300000
# Each token actually shown in a trending/degen message is measured from that
# first displayed price. Whole-number milestones are sent once for two hours.
MULTIPLE_MONITOR_ENABLED=true
MULTIPLE_MONITOR_WINDOW_SECONDS=7200
MULTIPLE_MONITOR_POLL_MS=15000
MULTIPLE_MONITOR_MIN_MILESTONE=2
MULTIPLE_MONITOR_MAX_ACTIVE_PER_CHAIN=200
# A continuously rediscovered token never resets its baseline after two hours.
# It can receive a new baseline only after disappearing for at least one day.
MULTIPLE_MONITOR_REARM_SECONDS=86400
SCHEDULED_CHAINS=sol,bsc,robinhood
TRENDING_DIGEST_LIMIT=10
# Cross-chain discovery starts with the latest 5m ranking, then confirms that
# participation and structure persist across 15m, 30m, and 1h. The digest emits
# event changes only: a new entrant, positive price action, a surge, or a new
# Smart Money confirmation. Unchanged rows are silent.
TRENDING_PRICE_LOOKBACK_SECONDS=1800
TRENDING_30M_PRICE_INCREASE_PERCENT=100
TRENDING_MAX_MARKET_CAP_USD=500000
TRENDING_MIN_POSITIVE_CHANGE_PERCENT=0
# An unchanged signal can return after this cooldown only after the configured
# price improvement from its last successful delivery.
TRENDING_SIGNAL_COOLDOWN_SECONDS=1800
TRENDING_REEMIT_MIN_PRICE_GAIN_PERCENT=5
# A token that leaves the ranking for this long is treated as a fresh re-entry.
TRENDING_REENTRY_SECONDS=21600
TRENDING_MULTIWINDOW_CHECK_LIMIT_PER_CHAIN=10
TRENDING_REQUIRE_MULTIWINDOW_STABILITY=true
TRENDING_MIN_STABILITY_SCORE=60
TRENDING_MIN_VOLUME_15M_USD=50000
TRENDING_MAX_DRAWDOWN_1H_PERCENT=45
TRENDING_MAX_VOLATILITY_1H_RATIO=0.30
TRENDING_MIN_RETURN_30M_PERCENT=-30
# High-risk feed: only the top-ranked filtered setups across all scheduled chains.
# Sub-$100k rows are ranked first, and recent GMGN surge/ATH/smart-money events
# are added when they are in that microcap band. Never auto-trades.
DEGEN_MODE=true
DEGEN_MAX_MARKET_CAP_USD=100000
DEGEN_DIGEST_LIMIT=20
# Reserve at least 75% of available degen slots for Robinhood when enough exist.
DEGEN_ROBINHOOD_MIN_SHARE=0.75
# Public Pons launchpad discovery for Robinhood: active curves + recent graduates.
PONS_ENABLED=true
PONS_SCAN_EVERY_MS=300000
PONS_ACTIVE_PAGE_SIZE=50
PONS_LAUNCH_AGE=7d
PONS_GRADUATED_MAX_AGE_SECONDS=604800
# GMGN chart confirmation is deliberately capped to preserve rate-limit headroom.
PONS_GMGN_PROBE_LIMIT=12
# Rich Telegram cards: token info + top holders, after the top-20 ranking is known.
PONS_CARD_ENRICH_LIMIT=20
PONS_CARD_HOLDER_LIMIT=5
PONS_SURGE_5M_PERCENT=30
PONS_SURGE_30M_PERCENT=100
PONS_PROGRESS_SURGE_30M_POINTS=5
PONS_NEAR_GRADUATION_PERCENT=50
PONS_RECENT_BUY_SECONDS=900
PONS_JUST_GRADUATED_SECONDS=21600
PONS_NEW_LAUNCH_SECONDS=1800
PONS_NEW_LAUNCH_MIN_MC_USD=3000
MIN_TRACKED_BUY_WALLETS=3
WALLET_CLUSTER_ALERT_COOLDOWN_MS=1800000
TRACKED_WALLET_BUY_ALERT_COOLDOWN_MS=1800000
# Conservative headroom below GMGN's documented 20-unit/s, 20-unit burst limit.
GMGN_RATE_LIMIT_UNITS_PER_SECOND=8
GMGN_RATE_LIMIT_BURST_UNITS=8
GMGN_RATE_LIMIT_COOLDOWN_BUFFER_MS=2000
TRACKED_WALLET_SCAN_EVERY_MS=300000
# The roster is scanned in rotating batches, so every wallet is eventually covered.
TRACKED_WALLET_FALLBACK_LIMIT=5
TRACKED_BUY_ENRICH_CONCURRENCY=3
GMGN_MIN_TRENDING_TRADER_ROI_PERCENT=500
GMGN_RUNNER_MIN_ATH_MARKET_CAP_USD=1000000
# Optional research evidence: only KOL-backed runners get a 1-minute pre-move study.
GMGN_RUNNER_MIN_RENOWNED_COUNT=2
GMGN_RUNNER_PRE_MOVE_LEAD_SECONDS=21600
GMGN_RUNNER_PUMP_CANDLE_PERCENT=20
GMGN_RUNNER_PUMP_5M_PERCENT=35
GMGN_RUNNER_PUMP_VOLUME_RATIO=3
SIGNAL_LOOKBACK_SECONDS=1800
TRENDING_LIMIT=30
MIN_PRICE_SURGE_5M_PERCENT=10
MIN_SIGNAL_STRENGTH=3
MAX_CANDIDATES_PER_CHAIN=5
SIGNAL_ALERT_COOLDOWN_MS=21600000
ALERT_TIERS=CALL,RESEARCH

# Authenticated, read-only Fomo discovery.
FOMO_TOKEN=
# Opens ordinary Chrome with a dedicated profile, then attaches over localhost.
# Log into Fomo once; Privy refreshes the session in-browser and the helper stores
# only the short-lived Fomo bearer. Google credentials never enter the bot.
FOMO_BROWSER_SESSION=false
FOMO_TOKEN_FILE=.runtime/fomo-token.json
FOMO_BROWSER_PROFILE=.runtime/fomo-chrome-profile
FOMO_BROWSER_DEBUG_PORT=9223
FOMO_BROWSER_REFRESH_BEFORE_EXPIRY_SECONDS=1800
FOMO_LOCAL_SYNC_MIN_TOKEN_TTL_SECONDS=1800
FOMO_LOCAL_SYNC_TOKEN_TIMEOUT_MS=120000
# FOMO_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
FOMO_SCAN_EVERY_MS=300000
FOMO_TRACKED_PROFILES=1000
FOMO_ACTIVITY_CONCURRENCY=4
FOMO_TRENDING_WALLET_MIN_ATH_MARKET_CAP_USD=1000000
# Fomo managed wallets returned zero GMGN activity in live validation. Enable only for periodic rechecks.
FOMO_GMGN_VALIDATION=false
FOMO_MIN_POSITION_ROI_PERCENT=500
FOMO_MIN_COST_BASIS_USD=100
FOMO_MIN_POSITION_VALUE_USD=100
FOMO_MIN_USER_TRADES=20
FOMO_MIN_USER_VOLUME_USD=1000
FOMO_MIN_LEADERBOARD_PNL_USD=1000
# An elite leaderboard trader is monitored even when its latest closed-trade sample is weak.
FOMO_ELITE_MIN_LEADERBOARD_PNL_USD=100000
FOMO_MIN_LEADERBOARD_VOLUME_USD=5000
FOMO_MIN_LEADERBOARD_TRADES=30
FOMO_MIN_PROFITABLE_TOP_HOLDINGS_RATE=0.5
FOMO_MIN_CLOSED_TRADE_SAMPLE=10
FOMO_MIN_NATIVE_REALIZED_PNL_USD=500
FOMO_MIN_NATIVE_WILSON=0.25

# Keep this false when a local cron runs sync:wallets:local against the same MongoDB.
DAILY_WALLET_REFRESH_ENABLED=false
DAILY_WALLET_REFRESH_HOUR_LOCAL=3
# Deployed services reload rosters written by the local daily sync.
MONGO_ROSTER_RELOAD_MS=300000

# Web API. Set a strong token before exposing the admin endpoints publicly.
HOST=127.0.0.1
PORT=3000
WEB_API_TOKEN=

# GMGN_API_KEY and GMGN_PRIVATE_KEY stay in ~/.config/gmgn/.env.
