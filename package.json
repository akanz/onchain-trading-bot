{
  "name": "gmgn-profitable-wallet-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS multi-chain wallet tracker with Telegram alerts and a web API.",
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "dev:watch": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\" \"*.{json,md}\"",
    "lint:complexity": "biome lint src",
    "test": "node --import tsx --test test/*.test.ts",
    "scan:daily-wallets": "node --import tsx scripts/daily-wallet-scan.ts",
    "scan:gmgn-wallets": "node --import tsx scripts/daily-wallet-scan.ts",
    "scan:runner-wallets": "node --import tsx scripts/runner-wallet-scan.ts",
    "scan:signals": "node --import tsx src/scan-once.ts",
    "migrate:mongodb": "node --import tsx scripts/migrate-sqlite-to-mongodb.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "gmgn-cli": "1.5.9",
    "grammy": "^1.46.0",
    "mongodb": "^6.20.0",
    "mongoose": "^9.9.4",
    "playwright-core": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.4.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
